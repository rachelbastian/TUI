# Serial Port Configuration
# Leave empty to use standard terminal output
# For Raspberry Pi to VT-102, use something like: /dev/ttyUSB0 or /dev/ttyAMA0
SERIAL_PORT=

# Serial baud rate (VT-102 typically uses 9600)
BAUD_RATE=9600

# OpenRouter API Key for MU/TH/ER AI interaction
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here

# Terminal dimensions (VT-102 standard)
TERMINAL_WIDTH=80
TERMINAL_HEIGHT=24